# ---------- Cloud (Vercel → Settings → Environment Variables) ----------
# Added automatically when you connect a Neon Postgres database in Vercel Storage.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Secret the edge gateway sends in the x-api-key header. Make it long and random.
INGEST_API_KEY=change-me-to-a-long-random-string
# Needed to change settings / acknowledge alerts on the website. Leave empty to allow everyone.
ADMIN_KEY=change-me-too

# ---------- Edge gateway (the PC at the station) ----------
CLOUD_URL=https://your-project.vercel.app
EDGE_ID=hub-01
ESP32_PORT=COM5
